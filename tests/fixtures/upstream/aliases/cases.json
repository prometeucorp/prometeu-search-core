    {
      "name": "root-alias",
      "manifests": {
        "tsconfig.json": "{\"compilerOptions\":{\"baseUrl\":\".\",\"paths\":{\"#app/*\":[\"src/local/*\"],\"@/*\":[\"src/*\"]}}}"
      },
      "files": [
        "src/main.ts",
        "src/local/test.ts",
        "src/Page.vue"
      ],
      "expected": [
        {
          "from": "src/main.ts",
          "source": "#app/test",
          "language": "typescript",
          "target": "src/local/test.ts"
        },
        {
          "from": "src/main.ts",
          "source": "@/Page",
          "language": "vue",
          "target": "src/Page.vue"
        }
      ],
      "maps": {
        "": {
          "baseUrl": "/fixture",
          "declaresBaseUrl": true,
          "patterns": [
            {
              "prefix": "#app/",
              "suffix": "",
              "hasWildcard": true,
              "replacements": [
                "src/local/*"
              ]
            },
            {
              "prefix": "@/",
              "suffix": "",
              "hasWildcard": true,
              "replacements": [
                "src/*"
              ]
            }
          ]
        }
      }
    },
